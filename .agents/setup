#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$repo_root"
SECONDS=0

# Keep this version aligned with the Dockerfile.
bun_version=1.3.14
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

printf '\n[setup +%ss] Preparing Bun %s\n' "$SECONDS" "$bun_version"
if ! command -v bun >/dev/null || [[ "$(bun --version)" != "$bun_version" ]]; then
  packages=()
  command -v curl >/dev/null || packages+=(curl ca-certificates)
  command -v unzip >/dev/null || packages+=(unzip)
  if (( ${#packages[@]} )); then
    sudo apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}"
  fi
  curl -fsSL --retry 3 https://bun.com/install | bash -s -- "bun-v$bun_version"
fi
[[ "$(bun --version)" == "$bun_version" ]]

# Amp and supervised services start in separate login shells, not this process.
profile_marker="# Fieldlab orb Bun toolchain ($repo_root)"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<PROFILE

$profile_marker
case "\$PWD/" in
  "$repo_root/"*)
    case "\$PATH" in
      "\$HOME/.bun/bin"|"\$HOME/.bun/bin":*) ;;
      *) export PATH="\$HOME/.bun/bin:\$PATH" ;;
    esac
    ;;
esac
PROFILE
fi

# Node is supplied by the orb base image and runs the Vite/Svelte tooling.
command -v node >/dev/null
printf '\n[setup +%ss] Installing workspace dependencies\n' "$SECONDS"
# The repository intentionally ignores bun.lock. Bun reuses it and node_modules
# from warm snapshots; do not force downloads or add a separate cache marker.
bun install

printf '\n[setup +%ss] Preparing environment and generated files\n' "$SECONDS"
if [[ ! -f .env ]]; then
  cp -- .env.example .env
fi
(
  cd apps/web
  bun x --no-install svelte-kit sync
)

# API route tests serve the generated static site, so it must exist before tests.
printf '\n[setup +%ss] Building the static site and API\n' "$SECONDS"
bun run build
printf '\n[setup +%ss] Ready: bun test; bun run check; amp orb services ensure\n' "$SECONDS"
